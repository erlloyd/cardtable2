{
  "name": "cardtable2",
  "version": "0.0.1",
  "private": true,
  "description": "Cardtable 2.0 - Solo-first card table with multiplayer support",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@cardtable2/app\" --filter \"@cardtable2/server\" run dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "fix": "oxfmt && oxlint --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.8.1"
}
