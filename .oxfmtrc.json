{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "build",
    "dist",
    "coverage",
    "node_modules",
    "pnpm-lock.yaml",
    "*.log",
    "*.md",
    ".env*",
    ".beads",
    ".claude",
    "**/routeTree.gen.ts"
  ]
}
