    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.3",
    "jsdom": "^30.1.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-mock-extended": "^5.1.1"
  }
